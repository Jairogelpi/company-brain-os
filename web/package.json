{
  "name": "company-brain-os-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "test": "vitest",
    "test:e2e": "vitest run src/domain/canonical-pedro-laura.e2e.test.ts",
    "test:browser:install": "playwright install chromium",
    "test:browser": "playwright test --config=playwright.config.ts",
    "typecheck:browser": "tsc --noEmit -p tsconfig.playwright.json",
    "test:critical": "vitest run --coverage --config vitest.critical.config.ts",
    "lint": "node scripts/lint.mjs",
    "format:check": "node scripts/format-check.mjs",
    "docs:audit": "node scripts/docs-audit.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "setup:hybrid": "node scripts/setup-hybrid.mjs",
    "test:integration": "cross-env TESTCONTAINERS=1 vitest --config test.integration.config.ts run",
    "verify:all": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@radix-ui/react-avatar": "^1.2.0",
