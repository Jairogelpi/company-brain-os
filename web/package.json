    "@testcontainers/postgresql": "^12.0.3",
    "@types/node": "26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.1",
    "testcontainers": "^12.0.3",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
