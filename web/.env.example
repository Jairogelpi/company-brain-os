# --- Database (required) ---
# In production the app refuses to start without this.
# Native/local PostgreSQL commonly uses 5432. For the recommended hybrid Docker
# setup, run `npm run setup:hybrid`; it selects a safe host port automatically
# and writes the verified DATABASE_URL to .env.local so the app and migrations
# cannot accidentally target different PostgreSQL instances.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/company_brain_os
# Production Compose uses a separate non-owner role so RLS cannot be bypassed.
# Generate a URL-safe secret, for example: openssl rand -hex 32
APP_DB_PASSWORD=

# --- Auth.js / NextAuth (required in production) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Set to true when running behind a reverse proxy / in Docker.
AUTH_TRUST_HOST=true

# --- Seeding (used by `npm run db:seed`) ---
# Password assigned to the demo users. Required for a non-default seed.
SEED_PASSWORD=

# --- File storage ---
# "disk" (default) or "s3".
STORAGE_DRIVER=disk
# For disk: directory to store uploads (mount a volume in production).
STORAGE_DIR=./uploads
# Production fails closed unless ClamAV is reachable.
MALWARE_SCAN_MODE=basic
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
UPLOAD_RETENTION_DAYS=365
# UPLOAD_RETENTION_WORKER_INTERVAL_MS=60000
# Optional dedicated secret; AUTH_SECRET is used when unset.
# UPLOAD_URL_SIGNING_SECRET=
# For s3 (SDK included):
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=          # optional, for Cloudflare R2 / MinIO
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_SERVER_SIDE_ENCRYPTION=AES256  # or aws:kms
# S3_KMS_KEY_ID=                    # required when bucket policy uses a KMS key

# --- LLM (optional; falls back to heuristics if unset) ---
# OPENCODE_API_KEY=

# --- Gemini (optional; powers AI-generated interview questions) ---
# Free key from Google AI Studio (https://aistudio.google.com/apikey).
# Without it, /capture uses only the fixed question bank.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # or gemini-2.5-pro for the strongest model

# --- Durable mission notifications (worker) ---
# Authenticated HTTP endpoint that accepts { id, to, title, body, actionUrl }.
# Without both values, email remains retryable and is never marked delivered.
# NOTIFICATION_EMAIL_WEBHOOK_URL=
# NOTIFICATION_EMAIL_WEBHOOK_TOKEN=
# APP_BASE_URL=https://brain.example.com
# NOTIFICATION_WORKER_INTERVAL_MS=5000
